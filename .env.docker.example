# Copy to .env.docker and fill in real values before running:
#
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker up --build
#
# This file contains placeholders only. Compose fails to start if any required
# value below is left empty, so a deployment cannot silently inherit a
# development default.

# --- Database ---------------------------------------------------------------
POSTGRES_USER=shop
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=shop

# --- Authentication ---------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_value
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_value

# --- Networking -------------------------------------------------------------
# Origins allowed to call the API from a browser (comma-separated).
FRONTEND_ORIGIN=http://localhost:8080
FRONTEND_PORT=8080
BACKEND_PORT=3000
# Same-origin through the nginx proxy; set to the public API URL if split.
VITE_API_URL=/api

# --- Payments (optional) ----------------------------------------------------
# Leave blank to disable a provider; the verify endpoint then reports it as
# not configured instead of pretending a payment succeeded.
STRIPE_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.paypal.com
