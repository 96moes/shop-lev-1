# Database (PostgreSQL) — copy to .env and fill in real values.
# Either provide DATABASE_URL (takes precedence) or the individual DB_* values.
# DATABASE_URL=postgresql://user:pass@localhost:5432/shop
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change_me
DB_DATABASE=shop

# Authentication — replace with strong random secrets outside development.
JWT_SECRET=change_me
JWT_REFRESH_SECRET=change_me

# Server
PORT=3000

# Browser origin(s) allowed to call the API (comma-separated for several).
FRONTEND_ORIGIN=http://localhost:5173

# Payment providers — leave blank to disable a method; the endpoint then
# reports it as not configured rather than pretending to succeed.
STRIPE_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox by default; use https://api-m.paypal.com for live.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Rate limiting (requests per minute per client).
RATE_LIMIT_PER_MINUTE=120
